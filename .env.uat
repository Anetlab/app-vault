# Server Configuration
SERVER_PORT=8089

# Database Configuration (Connection String)
# Use this for external PostgreSQL databases (AWS RDS, Azure, etc.)
# Format: postgres://username:password@host:port/database?sslmode=disable
# Note: Special characters in password are URL-encoded (! = %21)
DATABASE_URL=postgres://admin:LZgMYe8Zuk2trvcbW3LL%21T7R@192.168.3.59:5432/app_vault_db?sslmode=disable

# Examples for external databases:
# AWS RDS:        postgres://username:password@mydb.123456.us-east-1.rds.amazonaws.com:5432/appvault?sslmode=require
# Azure Database: postgres://username@servername:password@servername.postgres.database.azure.com:5432/appvault?sslmode=require
# Heroku:         postgres://user:pass@host:5432/database?sslmode=require
# Railway:        postgres://user:pass@containers.railway.app:5432/railway?sslmode=require

# Docker Database Configuration (only needed if using docker-compose local postgres)
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=appvault
DB_PORT=5432

# Application environment: "development" (default) or "production".
# In production the server refuses to start with the placeholder JWT_SECRET
# and without TLS enabled.
APP_ENV=development

# Security Configuration
# IMPORTANT: replace with a random 32+ byte secret in production. The
# server will refuse to start in production while this still has the
# placeholder value.
JWT_SECRET=your-secret-key-change-this-in-production

# Migrations
MIGRATIONS_PATH=migrations

# TLS Configuration
ENABLE_TLS=false
TLS_CERT_FILE=certs/server.crt
TLS_KEY_FILE=certs/server.key

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SECONDS=60

# Request Size Limits
MAX_REQUEST_SIZE_MB=1
