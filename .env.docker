# App Vault Docker Compose Configuration
# Copy this file to .env and customize values

# ============================================
# Server Configuration
# ============================================
SERVER_PORT=8888
ENABLE_TLS=false
TLS_CERT_FILE=certs/server.crt
TLS_KEY_FILE=certs/server.key

# ============================================
# Database Configuration
# ============================================
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=appvault
DB_PORT=5432
DATABASE_URL=postgres://postgres:postgres@postgres:5432/appvault?sslmode=disable

# ============================================
# Security Configuration
# ============================================
# IMPORTANT: Change this in production! Generate with: openssl rand -hex 32
JWT_SECRET=change-this-to-a-random-32-byte-secret-in-production

# Argon2id password hashing parameters
ARGON_MEMORY=65536
ARGON_ITERATIONS=3
ARGON_PARALLELISM=4

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SECONDS=60
MAX_REQUEST_SIZE_MB=1

# ============================================
# Frontend Configuration
# ============================================
VITE_API_URL=/api/v1
VITE_APP_NAME=SecureVault
VITE_VERSION=2.1.0

# ============================================
# Migration Configuration
# ============================================
MIGRATIONS_PATH=migrations
