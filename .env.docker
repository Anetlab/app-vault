# App Vault Docker Compose Configuration
# Copy this file to .env and customize values

# ============================================
# Server Configuration
# ============================================
SERVER_PORT=8888
ENABLE_TLS=false
TLS_CERT_FILE=certs/server.crt
TLS_KEY_FILE=certs/server.key

# ============================================
# Database Configuration
# ============================================
# For Docker Compose with internal PostgreSQL (use --profile with-postgres)
DB_HOST=postgres
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=appvault
DB_PORT=5432
DB_SSLMODE=disable

# For External PostgreSQL (default when running docker-compose up)
# Uncomment and configure these:
# DB_HOST=localhost
# DB_HOST=your-external-postgres-host
# DB_USER=your_db_user
# DB_PASSWORD=your_db_password
# DB_NAME=appvault
# DB_PORT=5432
# DB_SSLMODE=require

DATABASE_URL=postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?sslmode=${DB_SSLMODE}

# ============================================
# Security Configuration
# ============================================
# IMPORTANT: Change this in production! Generate with: openssl rand -hex 32
JWT_SECRET=change-this-to-a-random-32-byte-secret-in-production

# Argon2id password hashing parameters
ARGON_MEMORY=65536
ARGON_ITERATIONS=3
ARGON_PARALLELISM=4

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SECONDS=60
MAX_REQUEST_SIZE_MB=1

# ============================================
# Frontend Configuration
# ============================================
VITE_API_URL=/api/v1
VITE_APP_NAME=SecureVault
VITE_VERSION=2.1.0

# ============================================
# Migration Configuration
# ============================================
MIGRATIONS_PATH=migrations
